// Optional: Cloudflare Workers static assets (no Worker script, so no billable code runs).
// Deploy with: npm run build && npx wrangler deploy
{
  "name": "mof-discovery-studio",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
